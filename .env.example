# Cuentas de Savia con Firebase (opcional).
# Copia este archivo como .env.local y llena los valores con los de tu proyecto:
# Consola de Firebase → Configuración del proyecto → Tus apps → App web → firebaseConfig.
# Estos valores son públicos (van dentro de la app); la seguridad la dan las reglas de
# Firestore (firestore.rules). Si se dejan vacíos, Savia funciona sin cuentas.
# En Cloudflare Pages se configuran en Settings → Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
